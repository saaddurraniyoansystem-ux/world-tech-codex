/* ---- Email ---- */
async function sendWeb3(to,name,sub,html){
 const fd=new FormData();
 fd.append("access_key",W3F_KEY);fd.append("subject",sub);fd.append("from_name",me.name+" - Sales Hub CRM");
 fd.append("name",name||to);fd.append("email",to);
 fd.append("message","To: "+to+"\n\n"+toText(html));
 const r=await fetch("https://api.web3forms.com/submit",{method:"POST",body:fd}),d=await r.json();
 if(!r.ok||d.success===false)throw Error(d.message||"Email could not be sent.");
}
async function sendMail(to,name,sub,html,tid){
 if(!EMAILJS.publicKey)return sendWeb3(to,name,sub,html);
 const r=await fetch("https://api.emailjs.com/api/v1.0/email/send",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({service_id:EMAILJS.serviceId,template_id:EMAILJS.templates[tid]||EMAILJS.templateId,user_id:EMAILJS.publicKey,template_params:{to_email:to,to_name:name||to,from_name:me.name,reply_to:me.email,subject:sub,message_html:asHtml(html),message:toText(html)}})});
 if(!r.ok)throw Error((await r.text())||"Email could not be sent.");
}
function rEmail(){
 const sent=[];db.leads.forEach(l=>(l.tl||[]).forEach(t=>t.type==="email"&&sent.push({...t,company:l.company})));sent.sort((a,b)=>b.at-a.at);
 $("#main").innerHTML=`<div class="cols"><div class="card"><h3>Compose email</h3>
 <label>From</label><input value="${esc(me.name)} <${esc(me.email)}>" disabled>
 <div class="grid"><div><label>Lead</label><select id="el"><option value="">-- select lead --</option>${db.leads.map(l=>`<option value="${l.id}" ${l.id===emailTo?"selected":""}>${esc(l.company)}${l.contact?" - "+esc(l.contact):""}</option>`).join("")}</select></div><div><label>Template</label><select id="et"><option value="">-- none --</option>${db.templates.map(t=>`<option value="${t.id}">${esc(t.name)}</option>`).join("")}</select></div></div>
 <label>To</label><input id="eto" type="email" placeholder="recipient@company.com"><label>Subject</label><input id="esub">
 <label>Message (plain text or HTML)</label><textarea id="eb" class="code" style="min-height:200px;white-space:pre-wrap"></textarea>
 <div class="cmd" style="margin:14px 0 0;box-shadow:none;border:0;padding:0"><button class="btn p" id="es">${ic("send")}Send email</button><button class="btn" id="eo">${ic("ext")}Open in email app</button><button class="btn" id="ec">${ic("copy")}Copy HTML</button></div></div>
 <div class="card"><h3>Preview</h3><iframe class="pv" id="pv" sandbox></iframe></div></div>
 <div class="card tw"><h3>Sent emails</h3>${sent.length?`<table><thead><tr><th>Date</th><th>Lead</th><th>To</th><th>Subject</th></tr></thead><tbody>${sent.map(s=>`<tr style="cursor:default"><td>${new Date(s.at).toLocaleString()}</td><td>${esc(s.company)}</td><td>${esc(s.to)}</td><td>${esc(s.subject)}</td></tr>`).join("")}</tbody></table>`:'<div class="empty">No emails sent yet</div>'}</div>`;
 const prev=()=>$("#pv").srcdoc=asHtml($("#eb").value)||"";
 const apply=()=>{const l=lead($("#el").value),t=tpl($("#et").value);if(t){$("#esub").value=fill(t.subject,l);$("#eb").value=fill(t.html,l,true)}prev()};
 $("#el").onchange=()=>{const l=lead($("#el").value);$("#eto").value=l?.email||"";apply()};
 $("#et").onchange=apply;$("#eb").oninput=prev;
 if(emailTo){$("#eto").value=lead(emailTo)?.email||"";emailTo=null}
 $("#ec").onclick=()=>navigator.clipboard.writeText($("#eb").value).then(()=>toast("HTML copied"),()=>toast("Copy failed",true));
 const check=()=>{const to=$("#eto").value.trim();if(!/^\S+@\S+\.\S+$/.test(to)){toast("Enter a valid recipient email.",true);return}if(!$("#esub").value.trim()||!$("#eb").value.trim()){toast("Add a subject and a message.",true);return}return to};
 const log=(to)=>{const l=lead($("#el").value);if(l){(l.tl||=[]).push({type:"email",to,subject:$("#esub").value,text:toText($("#eb").value),at:Date.now()});if(l.status==="New")l.status="Contacted";save()}};
 $("#eo").onclick=()=>{const to=check();if(!to)return;log(to);location.href="mailto:"+encodeURIComponent(to)+"?subject="+encodeURIComponent($("#esub").value)+"&body="+encodeURIComponent(toText($("#eb").value));setTimeout(rEmail,400)};
 $("#es").onclick=async()=>{const to=check();if(!to)return;const b=$("#es");b.disabled=true;b.lastChild.textContent="Sending...";
  try{await sendMail(to,lead($("#el").value)?.contact,$("#esub").value,$("#eb").value,$("#et").value);log(to);toast("Success! Your email has been sent.");rEmail()}
  catch(e){toast(em(e)||"Something went wrong. Please try again.",true);b.disabled=false;b.lastChild.textContent="Send email"}};
}
