<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sales Hub CRM</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>try{document.documentElement.dataset.theme=JSON.parse(localStorage.getItem("shcrm_theme"))||(matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light")}catch(e){document.documentElement.dataset.theme="light"}</script>
<style>
:root{--bg:#eef1f6;--card:#fff;--tx:#16202e;--mu:#5d6b7e;--bd:#e0e6ef;--pr:#1160c7;--pr2:#0b3d91;--nav:#0a1f44;--in:#f3f6fa;--ok:#12805c;--er:#c0392b;--sh:0 1px 2px rgba(16,32,60,.06),0 4px 14px rgba(16,32,60,.06);--shh:0 12px 30px rgba(16,32,60,.16)}
:root[data-theme=dark]{--bg:#0f1520;--card:#18202e;--tx:#e9eef6;--mu:#9aa9bd;--bd:#2a3547;--pr:#4f9fe6;--pr2:#2b6fc0;--nav:#0a1220;--in:#202a3b;--sh:0 1px 2px rgba(0,0,0,.3),0 4px 14px rgba(0,0,0,.25);--shh:0 12px 30px rgba(0,0,0,.45)}
*{box-sizing:border-box}
body{margin:0;font:14px/1.5 "Plus Jakarta Sans","Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--tx)}
.hide{display:none!important}
button{font:inherit;cursor:pointer}
button:focus-visible{outline:2px solid var(--pr);outline-offset:2px}
input,select,textarea{font:inherit;color:var(--tx);background:var(--in);border:1px solid var(--bd);border-radius:8px;padding:9px 11px;width:100%;transition:border-color .2s,box-shadow .2s,background .2s}
input:hover,select:hover,textarea:hover{border-color:#8fa6c6}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--pr);box-shadow:0 0 0 3px color-mix(in srgb,var(--pr) 22%,transparent);background:var(--card)}
textarea{resize:vertical;min-height:90px}
label{display:block;font-size:12px;font-weight:600;color:var(--mu);margin:12px 0 4px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--card);border:1px solid var(--bd);color:var(--tx);border-radius:8px;padding:8px 14px;font-weight:600;transition:transform .15s,box-shadow .2s,border-color .2s,background .2s}
.btn:hover{transform:translateY(-1px);box-shadow:var(--sh);border-color:var(--pr)}
.btn:active{transform:none}
.btn.p{background:linear-gradient(135deg,var(--pr),var(--pr2));color:#fff;border-color:transparent}
.btn.p:hover{box-shadow:0 8px 20px rgba(17,96,199,.4)}
.btn.d{color:var(--er)}.btn.d:hover{border-color:var(--er)}
.btn[disabled]{opacity:.6;pointer-events:none}
.btn.wide{width:100%;margin-top:18px;padding:11px}
.ic{width:17px;height:17px;flex-shrink:0}
.lnk{background:none;border:0;color:var(--pr);font-weight:600;padding:0}.lnk:hover{text-decoration:underline}
.c{text-align:center}
/* auth */
#auth{min-height:100vh;display:grid;grid-template-columns:1.1fr 1fr}
.brand{position:relative;overflow:hidden;color:#fff;padding:56px;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(120deg,#0a1f44,#1160c7,#0a1f44);background-size:220% 220%;animation:flow 16s ease infinite}
.brand::before,.brand::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.07);animation:float 10s ease-in-out infinite}
.brand::before{width:340px;height:340px;top:-90px;right:-90px}
.brand::after{width:230px;height:230px;bottom:-60px;left:12%;animation-delay:-5s}
.brand>*{position:relative;z-index:1}
.brand h1{font-size:36px;line-height:1.15;margin:18px 0 12px}
.brand p{opacity:.85;max-width:400px;margin:0 0 22px}
.brand li{list-style:none;margin:10px 0;padding-left:26px;position:relative;opacity:.95}
.brand li::before{content:"";position:absolute;left:0;top:6px;width:12px;height:12px;border-radius:50%;background:#7fc4ff;box-shadow:0 0 0 4px rgba(127,196,255,.25)}
.brand ul{padding:0;margin:0}
.logo{width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.16);display:grid;place-items:center}
.pane{display:flex;align-items:center;justify-content:center;padding:24px}
.box{width:100%;max-width:400px;animation:rise .5s ease both}
.box h2{margin:0 0 4px;font-size:24px}.sub{color:var(--mu);margin:0 0 10px}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--bd);margin:14px 0 4px}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:9px 12px;color:var(--mu);font-weight:600;transition:color .2s,border-color .2s}
.tabs button:hover{color:var(--tx)}.tabs button.on{color:var(--pr);border-color:var(--pr)}
.msg{padding:9px 12px;border-radius:8px;margin-top:14px;font-size:13px;display:none}
.msg.er{display:block;background:#fde8e6;color:#a1271b}.msg.ok{display:block;background:#dcf5ea;color:#0b5f43}
.demo{margin-top:16px;font-size:12px;color:var(--mu);background:var(--in);border-radius:8px;padding:9px 12px}
#splash{position:fixed;inset:0;display:grid;place-items:center;background:var(--bg);z-index:50}
.spin{width:36px;height:36px;border:4px solid var(--bd);border-top-color:var(--pr);border-radius:50%;animation:spin .8s linear infinite}
/* app */
header{background:var(--nav);color:#fff;height:56px;display:flex;align-items:center;gap:12px;padding:0 18px;position:sticky;top:0;z-index:5}
header b{font-size:16px}header .sp{flex:1}
.av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#7fc4ff,#b79bff);color:#0a1f44;display:grid;place-items:center;font-weight:700;flex-shrink:0}
header .btn{background:transparent;color:#fff;border-color:rgba(255,255,255,.3);padding:6px 10px}
header .btn:hover{background:rgba(255,255,255,.12);border-color:#fff;box-shadow:none}
.shell{display:flex}
nav{width:88px;background:var(--card);border-right:1px solid var(--bd);position:sticky;top:56px;height:calc(100vh - 56px);align-self:flex-start;padding-top:8px}
nav button{display:flex;flex-direction:column;align-items:center;gap:4px;width:100%;background:none;border:0;border-left:3px solid transparent;padding:14px 4px;color:var(--mu);font-size:11px;font-weight:600;transition:background .2s,color .2s,border-color .2s}
nav button .ic{width:22px;height:22px;transition:transform .2s}
nav button:hover{background:var(--in);color:var(--tx)}nav button:hover .ic{transform:scale(1.15)}
nav button.on{border-color:var(--pr);color:var(--pr);background:var(--in)}
main{flex:1;min-width:0;padding:20px}
main.enter{animation:rise .35s ease both}
.cmd{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:8px;display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;align-items:center;box-shadow:var(--sh)}
.cmd .btn{border-color:transparent;background:none}.cmd .btn:hover{background:var(--in);box-shadow:none}.cmd .btn.p{background:linear-gradient(135deg,var(--pr),var(--pr2))}
.cmd input,.cmd select{width:auto;flex:1;min-width:150px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:16px}
.stat{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px 16px;box-shadow:var(--sh);transition:transform .2s,box-shadow .2s}
.stat:hover{transform:translateY(-3px);box-shadow:var(--shh)}
.stat b{font-size:26px;display:block;line-height:1.2}.stat small{color:var(--mu);font-weight:500}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:18px;margin-bottom:16px;box-shadow:var(--sh)}
.card h3{margin:0 0 6px;font-size:15px}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--bd);white-space:nowrap}
th{color:var(--mu);font-weight:600;font-size:12px}
tbody tr{cursor:pointer;transition:background .15s,box-shadow .15s}
tbody tr:hover{background:var(--in);box-shadow:inset 3px 0 0 var(--pr)}
.who{display:flex;align-items:center;gap:10px}.who .av{width:30px;height:30px;font-size:12px}
.tag{display:inline-block;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:600;background:var(--in)}
.r-Hot{background:#fde8e6;color:#b3281b}.r-Warm{background:#fff0d3;color:#a35f00}.r-Cold{background:#e1efff;color:#0b4f9c}
.hd{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.hd .av{width:54px;height:54px;font-size:20px}
.hd h2{margin:0;font-size:21px}.hd .meta{margin-left:auto;display:flex;gap:22px;color:var(--mu);font-size:12px}.hd .meta b{display:block;color:var(--tx);font-size:14px}
.stages{display:flex;margin-top:16px;gap:4px;overflow-x:auto}
.stages button{flex:1;min-width:92px;background:var(--in);border:0;padding:11px 8px;color:var(--mu);font-weight:600;border-radius:8px;transition:background .25s,color .25s,transform .15s}
.stages button:hover{transform:translateY(-2px);color:var(--tx)}.stages button.on{background:linear-gradient(135deg,var(--pr),var(--pr2));color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.cols{display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:start}
.tl{border-left:2px solid var(--bd);padding-left:14px;margin:12px 0 0 4px}.tl div{margin-bottom:12px}.tl small{color:var(--mu);display:block}
.empty{color:var(--mu);text-align:center;padding:30px}
.tg{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
.tc{background:var(--card);border:1px solid var(--bd);border-radius:12px;overflow:hidden;cursor:pointer;box-shadow:var(--sh);transition:transform .25s,box-shadow .25s,border-color .25s}
.tc:hover{transform:translateY(-5px);box-shadow:var(--shh);border-color:var(--pr)}
.thumb{height:190px;overflow:hidden;background:#f3f5f9}
.thumb iframe{width:620px;height:460px;border:0;transform:scale(.42);transform-origin:0 0;pointer-events:none;transition:transform .35s}
.tc:hover .thumb iframe{transform:scale(.45)}
.tc div.in{padding:12px 14px}.tc b{display:block}.tc small{color:var(--mu)}
iframe.pv{width:100%;height:420px;border:1px solid var(--bd);border-radius:10px;background:#fff}
.code{font-family:Consolas,"Courier New",monospace;font-size:12.5px;min-height:300px;white-space:pre}
.chips span{display:inline-block;background:var(--in);border:1px solid var(--bd);border-radius:6px;padding:2px 8px;margin:4px 4px 0 0;cursor:pointer;font-size:12px;transition:background .15s,border-color .15s}
.chips span:hover{background:var(--pr);color:#fff;border-color:var(--pr)}
.hint{font-size:12px;color:var(--mu);margin:8px 0 0}
#toasts{position:fixed;right:16px;top:70px;z-index:60;display:flex;flex-direction:column;gap:8px}
.toast{padding:10px 16px;border-radius:10px;color:#fff;background:#12805c;box-shadow:var(--shh);max-width:320px;animation:slide .3s ease both}
.toast.er{background:#c0392b}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes slide{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}
@keyframes flow{50%{background-position:100% 50%}}
@keyframes float{50%{transform:translateY(26px)}}
@keyframes spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media(max-width:850px){
 #auth{grid-template-columns:1fr}.brand{padding:32px 24px}.brand h1{font-size:26px}.brand ul{display:none}
 .shell{display:block}
 nav{position:fixed;bottom:0;left:0;right:0;top:auto;width:100%;height:auto;display:flex;border-right:0;border-top:1px solid var(--bd);z-index:6;padding:0}
 nav button{border-left:0;border-top:3px solid transparent;padding:8px 2px}nav button.on{border-top-color:var(--pr)}
 main{padding:12px 12px 90px}.grid,.cols{grid-template-columns:1fr}.hd .meta{margin-left:0;width:100%}
 header .un{display:none}
}
</style>
</head>
<body>
<div id="splash"><div class="spin"></div></div>

<div id="auth" class="hide">
 <section class="brand">
  <div class="logo"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3zM8 7V5h8v2"/></svg></div>
  <h1>Manage every lead,<br>from any device.</h1>
  <p>Track companies, move them through your sales stages and email them with ready-made designs.</p>
  <ul><li>Your data is saved to your account</li><li>Login from your phone, laptop or office PC</li><li>Custom HTML email templates</li></ul>
 </section>
 <section class="pane"><div class="box">
  <h2>Sales Hub CRM</h2><p class="sub">Sign in to manage your leads</p>
  <div class="tabs"><button data-t="login" class="on">Login</button><button data-t="signup">Sign up</button><button data-t="forgot">Forgot password</button></div>
  <form id="af" novalidate></form>
  <div id="authMsg" class="msg"></div>
  <div id="demo" class="demo hide">Demo mode: accounts are stored in this browser only. Add your Firebase config in the code to enable login from other devices.</div>
 </div></section>
</div>

<div id="app" class="hide">
 <header><b>Sales Hub CRM</b><span class="sp"></span><span class="un" id="who"></span><div class="av" id="av"></div><button class="btn" id="logout" title="Logout" aria-label="Logout"></button></header>
 <div class="shell">
  <nav id="nav"></nav>
  <main id="main"></main>
 </div>
</div>
<div id="toasts"></div>

<script type="module">
/* ============ SETTINGS ============ */
// 1) Paste your Firebase web app config here to enable accounts that work on every device.
const FIREBASE_CONFIG={apiKey:"",authDomain:"",projectId:"",appId:""};
// 2) Web3Forms access key used by the Send email button.
const W3F_KEY="8eab78cf-3828-4528-b03d-a69bb8acd562";
// 3) EmailJS: sends the email to the LEAD from your connected Gmail, with the HTML design. Leave empty to use Web3Forms (goes to your own inbox only).
const EMAILJS={
 publicKey:"ZsVRQknsJwYJz6WJj",
 serviceId:"service_tn0uz4j",
 templateId:"template_hjmcflb", // default, used for custom templates
 templates:{t1:"template_hjmcflb",t2:"template_27rhs7p"} // CRM template id -> EmailJS template id. Add more here later.
};

/* ============ HELPERS ============ */
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const lg=k=>{try{return JSON.parse(localStorage.getItem(k))}catch(e){return null}};
const ls=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v));return true}catch(e){return false}};
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const clone=o=>JSON.parse(JSON.stringify(o));
const I={leads:"M3 7h18v12H3zM8 7V5h8v2",mail:"M3 5h18v14H3zM3 6l9 7 9-7",tpl:"M4 4h16v16H4zM4 9h16M10 9v11",user:"M12 12a4 4 0 100-8 4 4 0 000 8zM4 21c0-4 4-6 8-6s8 2 8 6",plus:"M12 5v14M5 12h14",trash:"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13",save:"M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6",back:"M15 5l-7 7 7 7",send:"M4 12l16-8-6 16-3-7z",copy:"M8 8h12v12H8zM4 4h12v3M4 4v12h3",out:"M9 4H4v16h5M16 8l4 4-4 4M20 12H9",dl:"M12 4v12M7 11l5 5 5-5M5 20h14",ext:"M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"};
const ic=n=>`<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="${I[n]}"/></svg>`;
function toast(t,er){const d=document.createElement("div");d.className="toast"+(er?" er":"");d.textContent=t;$("#toasts").appendChild(d);setTimeout(()=>d.remove(),3200)}
const FR={"auth/email-already-in-use":"This email is already registered. Please login.","auth/invalid-credential":"Incorrect email or password.","auth/wrong-password":"Incorrect email or password.","auth/user-not-found":"No account found with this email.","auth/weak-password":"Password must be at least 6 characters.","auth/invalid-email":"Enter a valid email address.","auth/too-many-requests":"Too many attempts. Try again later.","auth/network-request-failed":"No internet connection.","permission-denied":"Permission denied. Check your Firestore rules."};
const em=e=>FR[e?.code]||e?.message||"Something went wrong.";
const countUp=el=>{const n=+el.dataset.n;if(!n||matchMedia("(prefers-reduced-motion:reduce)").matches){el.textContent=n;return}let s=null;const f=t=>{s??=t;const p=Math.min((t-s)/600,1);el.textContent=Math.round(n*(1-Math.pow(1-p,3)));p<1&&requestAnimationFrame(f)};requestAnimationFrame(f)};

/* ============ EMAIL TEMPLATES (built-in) ============ */
const bt=(c,t)=>`<p><a href="mailto:{{senderEmail}}?subject=Call%20with%20World%20Tech%20Codex" style="display:inline-block;background:${c};color:#ffffff;padding:11px 22px;border-radius:6px;text-decoration:none;font-weight:bold">${t}</a></p>`;
const T=(c,h,b)=>`<div style="background:#f3f5f9;padding:24px 12px;font-family:Arial,Helvetica,sans-serif"><table align="center" width="560" style="max-width:100%;background:#ffffff;border-radius:10px;overflow:hidden"><tr><td style="background:${c};color:#ffffff;padding:28px 30px;font-size:22px;font-weight:bold">${h}</td></tr><tr><td style="padding:28px 30px;color:#26303f;font-size:15px;line-height:1.65">${b}</td></tr><tr><td style="padding:16px 30px;background:#f3f5f9;color:#7a8696;font-size:12px">Sent by {{sender}} &middot; {{senderEmail}}</td></tr></table></div>`;
// To add a new built-in design later: push another object here (id must be unique).
const DEFTPL=[
 {id:"t1",name:"Introduction",subject:"Introduction from {{sender}} - {{company}}",html:T("#1160c7","Let's work together",`<p>Dear {{contact}},</p><p>I am {{sender}} from <b>World Tech Codex</b>. I would like to introduce our services to <b>{{company}}</b> and explore how we can help your business grow.</p><p>Could we schedule a short call this week?</p>${bt("#1160c7","Book a call")}<p>Best regards,<br>{{sender}}<br>World Tech Codex</p>`)},
 {id:"t2",name:"Follow-up",subject:"Following up - {{company}}",html:T("#1160c7","Just following up",`<p style="margin:0 0 14px">Hi {{contact}},</p><p style="margin:0 0 14px">I hope you are doing well. I reached out earlier to introduce <b>World Tech Codex</b>, and I wanted to follow up in case my message got buried in your inbox.</p><p style="margin:0 0 14px">We would love to understand the goals of <b>{{company}}</b> and share how we can help you move faster with the right technology.</p><p style="margin:0 0 20px">Would you have 15 minutes this week for a quick call?</p>${bt("#1160c7","Schedule a call")}<p style="margin:0 0 14px">If now is not the right time, just let me know and I will check back later.</p><p style="margin:0">Best regards,<br><b>{{sender}}</b><br>World Tech Codex</p>`)},
 {id:"t3",name:"Proposal",subject:"Proposal for {{company}}",html:T("#0a1f44","Your proposal is ready",`<p>Dear {{contact}},</p><p>Thank you for your time. Our proposal for <b>{{company}}</b> is ready, and I would be happy to walk you through the details.</p>${bt("#0a1f44","View proposal")}<p>Kind regards,<br>{{sender}}</p>`)},
 {id:"t4",name:"Thank you",subject:"Thank you, {{contact}}",html:T("#12805c","Thank you!",`<p>Dear {{contact}},</p><p>Thank you for choosing to work with us. We are delighted to support <b>{{company}}</b> and look forward to a great partnership.</p><p>Warm regards,<br>{{sender}}</p>`)}
];
const SAMPLE={contact:"Ali Khan",company:"Acme Ltd",email:"ali@acme.com",phone:"0300 0000000"};
const MERGE=["contact","company","sender","senderEmail","email","phone"];

/* ============ BACKEND (Firebase or local demo) ============ */
const useFB=!!FIREBASE_CONFIG.apiKey;
async function makeBackend(){
 if(useFB){
  const b="https://www.gstatic.com/firebasejs/10.12.2/";
  const [{initializeApp},A,S]=await Promise.all([import(b+"firebase-app.js"),import(b+"firebase-auth.js"),import(b+"firebase-firestore.js")]);
  const app=initializeApp(FIREBASE_CONFIG),au=A.getAuth(app),fs=S.getFirestore(app);
  return{
   signup:async(n,e,p)=>{const c=await A.createUserWithEmailAndPassword(au,e,p);try{await A.updateProfile(c.user,{displayName:n})}catch(x){}},
   login:(e,p)=>A.signInWithEmailAndPassword(au,e,p),
   reset:e=>A.sendPasswordResetEmail(au,e),
   logout:()=>A.signOut(au),
   watch:cb=>A.onAuthStateChanged(au,u=>cb(u&&{id:u.uid,name:u.displayName||u.email.split("@")[0],email:u.email})),
   load:async id=>{const d=await S.getDoc(S.doc(fs,"crm",id));return d.exists()?d.data():null},
   save:(id,d)=>S.setDoc(S.doc(fs,"crm",id),d)
  };
 }
 const hash=async p=>[...new Uint8Array(await crypto.subtle.digest("SHA-256",new TextEncoder().encode("shcrm:"+p)))].map(x=>x.toString(16).padStart(2,"0")).join("");
 let cb;const out=u=>u&&{id:u.email,name:u.name,email:u.email};
 const set=u=>{ls("shcrm_s",u?u.email:null);cb&&cb(out(u))};
 return{
  signup:async(n,e,p)=>{const us=lg("shcrm_u")||{};if(us[e])throw{code:"auth/email-already-in-use"};us[e]={name:n,email:e,ph:await hash(p)};ls("shcrm_u",us);set(us[e])},
  login:async(e,p)=>{const u=(lg("shcrm_u")||{})[e];if(!u||u.ph!==await hash(p))throw{code:"auth/invalid-credential"};set(u)},
  reset:async()=>{throw{message:"Password reset emails need Firebase. See setup steps."}},
  logout:async()=>set(null),
  watch:f=>{cb=f;const e=lg("shcrm_s");f(out(e&&(lg("shcrm_u")||{})[e]))},
  load:async id=>lg("shcrm_d_"+id),
  save:async(id,d)=>{if(!ls("shcrm_d_"+id,d))throw Error("Browser storage is full or blocked.")}
 };
}

